# Binaries
bin/
*.exe
*.dll
*.so
*.dylib

# Test/Data files
*.csv
*.xlsx
*.xls

# Allow test fixture CSVs and XLSX files used by reader tests
!internal/reader/testdata/*.csv
!internal/reader/testdata/*.xlsx

# Generated Reports (exclude docs/ — those are source documentation)
*.html
!docs/*.html
!desktop/frontend/index.html
!web/index.html

# IDEs
.vscode/
.idea/
*.swp
*.swo

# MacOS
.DS_Store

# Go
vendor/

# Local test data
Local_Tests_Manual/

# Local notes — never commit
Local_Files_do_not_track_do_not_commit/

# Secrets and credentials
.env
.env.*
*.pem

# Playwright auth / storage state (session cookies)
storageState.json
*storage-state.json
*storage-state*.json
playwright/.auth/

# Tool artifacts
.playwright-mcp/

# Release build artifacts (generated by scripts/release/)
/release/
schedulegate-*.zip

# Desktop GUI — track source, ignore build artifacts
desktop/bin/
desktop/.task/
desktop/desktop/
desktop/frontend/node_modules/

# Exceptions — track generated GUI artifacts needed for fresh clone builds
!desktop/frontend/dist/index.html
